// ═══════════════════════════════════════════════
// Rainbow Cake GO — Prisma Schema
// ═══════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum ProductAvailability {
  IN_STOCK
  ON_DEMAND
  OUT_OF_STOCK
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

enum OrderItemStatus {
  PENDING
  IN_TRANSIT
  IN_WAREHOUSE
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum ReturnStatus {
  REQUESTED
  COMPLETED
}

enum GroupOrderStatus {
  OPEN
  CLOSED
  PURCHASED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

// ── User ──────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  username           String   @unique
  passwordHash       String
  role               Role     @default(USER)
  whatsapp           String   // E.164 format, e.g. +5215512345678
  internalNotes      String?  @db.Text
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  emailVerified      Boolean  @default(false)
  emailVerifyToken   String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders             Order[]
  payments           Payment[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  itemLogs           OrderItemLog[]      @relation("LogChangedBy")
  uploadedPayments   Payment[]           @relation("PaymentUploader")
  whatsappContacts   WhatsAppContactLog[] @relation("WhatsAppUser")
  whatsappAdminLogs  WhatsAppContactLog[] @relation("WhatsAppAdmin")
  returns            Return[]

  @@index([email])
  @@index([username])
}

// ── Category ──────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
}

// ── Product ───────────────────────────────────

model Product {
  id            String              @id @default(cuid())
  sku           String              @unique
  name          String
  description   String?             @db.Text
  categoryId    String
  merchType     String?
  price         Decimal             @db.Decimal(10, 2)
  offerPrice    Decimal?            @db.Decimal(10, 2)
  offerStartsAt DateTime?
  offerEndsAt   DateTime?
  releaseDate   DateTime?
  availability  ProductAvailability @default(IN_STOCK)
  status        ProductStatus       @default(ACTIVE)
  stock         Int?
  imagePath     String?
  archivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  category      Category            @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  isGroupItem   Boolean             @default(false)
  groupOrderItem GroupOrderItem?

  @@index([categoryId, status, archivedAt])
  @@index([sku])
  @@index([isGroupItem])
}

// ── Order ─────────────────────────────────────
// The order status is DERIVED from its items:
// - Open: at least one item not closed (not DELIVERED/CANCELLED)
// - Completed: all items DELIVERED or CANCELLED (with at least one DELIVERED)
// - Cancelled: all items CANCELLED

model Order {
  id           String      @id @default(cuid())
  code         String      @unique
  userId       String
  groupOrderId String?
  note         String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation(fields: [userId], references: [id])
  groupOrder   GroupOrder? @relation(fields: [groupOrderId], references: [id])
  items        OrderItem[]

  @@index([userId])
  @@index([code])
  @@index([groupOrderId])
}

// ── OrderItem ─────────────────────────────────

model OrderItem {
  id                     String          @id @default(cuid())
  orderId                String
  productId              String
  groupOrderItemId       String?
  variant                String?
  snapshotName           String
  snapshotSku            String
  snapshotUnitPrice      Decimal         @db.Decimal(10, 2)
  quantity               Int
  quantityDelivered      Int             @default(0)
  quantityCancelled      Int             @default(0)
  additionalCharge       Decimal         @default(0) @db.Decimal(10, 2)
  additionalChargeManual Boolean         @default(false)
  paymentDueAt           DateTime?
  status                 OrderItemStatus @default(PENDING)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  order          Order              @relation(fields: [orderId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  groupOrderItem GroupOrderItem?    @relation(fields: [groupOrderItemId], references: [id])
  logs           OrderItemLog[]
  allocations    PaymentAllocation[]
  returnItems    ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@index([groupOrderItemId])
  @@index([status])
}

// ── OrderItemLog ──────────────────────────────

model OrderItemLog {
  id            String           @id @default(cuid())
  orderItemId   String
  fromStatus    OrderItemStatus?
  toStatus      OrderItemStatus
  deliveredDelta Int             @default(0)
  changedById   String
  note          String?          @db.Text
  createdAt     DateTime         @default(now())

  orderItem     OrderItem        @relation(fields: [orderItemId], references: [id])
  changedBy     User             @relation("LogChangedBy", fields: [changedById], references: [id])

  @@index([orderItemId])
}

// ── Payment ───────────────────────────────────

model Payment {
  id            String    @id @default(cuid())
  userId        String
  paidAt        DateTime
  amount        Decimal?  @db.Decimal(10, 2)
  method        String?
  reference     String?
  note          String?   @db.Text
  filePath      String?
  mimeType      String?
  originalName  String?
  uploadedById  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User                @relation(fields: [userId], references: [id])
  uploadedBy    User                @relation("PaymentUploader", fields: [uploadedById], references: [id])
  allocations   PaymentAllocation[]

  @@index([userId])
}

// ── PaymentAllocation ─────────────────────────

model PaymentAllocation {
  id            String   @id @default(cuid())
  paymentId     String
  orderItemId   String
  amountApplied Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  payment       Payment   @relation(fields: [paymentId], references: [id])
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([paymentId])
  @@index([orderItemId])
}

// ── Return ────────────────────────────────────

model Return {
  id                   String       @id @default(cuid())
  userId               String
  status               ReturnStatus @default(REQUESTED)
  reason               String?      @db.Text
  receiptFilePath      String?
  receiptMimeType      String?
  receiptOriginalName  String?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user                 User         @relation(fields: [userId], references: [id])
  items                ReturnItem[]

  @@index([userId])
  @@index([status])
}

// ── ReturnItem ────────────────────────────────

model ReturnItem {
  id            String   @id @default(cuid())
  returnId      String
  orderItemId   String
  refundAmount  Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  return_       Return    @relation(fields: [returnId], references: [id])
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
  @@index([orderItemId])
}

// ── EmailOutbox ───────────────────────────────

model EmailOutbox {
  id             String      @id @default(cuid())
  type           String
  toEmail        String
  subject        String
  html           String      @db.Text
  status         EmailStatus @default(PENDING)
  attempts       Int         @default(0)
  lastError      String?     @db.Text
  sentAt         DateTime?
  relatedOrderId String?
  relatedUserId  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
}

// ── AuditLog ──────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor      User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ── MessageTemplate ───────────────────────────

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  body      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── WhatsAppContactLog ────────────────────────

model WhatsAppContactLog {
  id          String   @id @default(cuid())
  userId      String
  adminId     String
  orderItemId String?
  message     String   @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation("WhatsAppUser", fields: [userId], references: [id])
  admin       User     @relation("WhatsAppAdmin", fields: [adminId], references: [id])
}

// ── Setting ───────────────────────────────────

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ── OrderCodeSequence ─────────────────────────
// We use a separate model to generate sequential order codes.
// This is managed via raw SQL in the migration.

model OrderCodeSequence {
  id    Int @id @default(autoincrement())
}

// ── Group Orders (Pedidos Grupales) ───────────

model GroupOrder {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  description      String?          @db.Text
  sourceNote       String?          @db.Text
  conditions       String?          @db.Text
  closesAt         DateTime?
  estimatedArrival String?
  status           GroupOrderStatus @default(OPEN)
  costsAppliedAt   DateTime?
  prorationMethod  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items            GroupOrderItem[]
  orders           Order[]
  costs            GroupOrderCost[]

  @@index([status])
  @@index([code])
}

model GroupOrderItem {
  id             String      @id @default(cuid())
  groupOrderId   String
  productId      String?     @unique
  name           String
  basePrice      Decimal     @db.Decimal(10, 2)
  variantLabel   String?
  variantOptions String[]    @default([])
  imagePath      String?
  stockQty       Int         @default(0)
  notSecured     Boolean     @default(false)
  publishedAt    DateTime?
  publishedQty   Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  groupOrder     GroupOrder  @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  product        Product?    @relation(fields: [productId], references: [id])
  orderItems     OrderItem[]

  @@index([groupOrderId])
}

model GroupOrderCost {
  id           String      @id @default(cuid())
  groupOrderId String
  concept      String
  amount       Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  groupOrder   GroupOrder  @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  @@index([groupOrderId])
}

model GroupOrderCodeSequence {
  id    Int @id @default(autoincrement())
}

// ── Promo Banners (Banners promocionales) ────

model PromoBanner {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  imagePath     String?
  merchType     String?
  ordersOpenAt  DateTime?
  ordersCloseAt DateTime?
  whatsappMsg   String?   @db.Text
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

// ── News Posts (Noticias y anuncios) ─────────

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  imagePath   String?
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
}
