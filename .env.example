# ══════════════════════════════════════════════
# Rainbow Cake GO — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ══════════════════════════════════════════════

# ── Base de datos ──────────────────────────────
DATABASE_URL=postgresql://rcg:rcg_secret_2024@db:5432/rainbow_cake_go
# Para desarrollo local sin Docker:
# DATABASE_URL=postgresql://rcg:rcg_secret_2024@localhost:15439/rainbow_cake_go

# ── Autenticación ──────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-random-32-char-string

# ── Aplicación ─────────────────────────────────
APP_URL=http://localhost:18473
TZ=America/Mexico_City
CURRENCY=MXN
LOCALE=es-MX
DEFAULT_PHONE_COUNTRY=MX

# ── Correo (SMTP) ─────────────────────────────
# En desarrollo usa Mailpit (docker compose --profile dev up)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Rainbow Cake GO <hola@rainbowcakego.com>

# ── Admin ──────────────────────────────────────
# El seed crea el primer admin con estos datos.
# NO dejes los valores por defecto en producción.
ADMIN_SEED_EMAIL=admin@rainbowcakego.com
ADMIN_SEED_PASSWORD=CambiarEnPrimerAcceso2024!
ADMIN_SEED_NAME=Administrador
ADMIN_NOTIFY_EMAILS=admin@rainbowcakego.com

# ── WhatsApp ───────────────────────────────────
WHATSAPP_BUSINESS_NUMBER=+5215512345678

# ── Archivos ───────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# ── Verificación de correo (opcional) ──────────
REQUIRE_EMAIL_VERIFICATION=false

# ── Puertos (solo Docker Compose) ─────────────
# Elegidos para no colisionar con servicios comunes
APP_HOST_PORT=18473
DB_HOST_PORT=15439
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025

# ── PostgreSQL (Docker) ───────────────────────
POSTGRES_USER=rcg
POSTGRES_PASSWORD=rcg_secret_2024
POSTGRES_DB=rainbow_cake_go
